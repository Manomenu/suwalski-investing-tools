{
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/*.egg-info": true,
        "**/.coverage": true,
        "**/.venv": true,
        "**/.artifacts": true,
        "**/node_modules": true,
        "**/dist": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "README.md": "CLAUDE.md, ruff.toml, .editorconfig, .gitignore, .dockerignore, *.code-workspace",
        "pyproject.toml": "uv.lock, pyrightconfig.json, .python-version",
        ".env.base": ".env, .env.example",
        "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig.json, vite.config.ts, index.html"
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "suwalski_investing_library",
        "suwalski_investing_server",
        "suwalski_investing_cli"
    ]
}
