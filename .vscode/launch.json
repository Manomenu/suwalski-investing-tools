{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run server",
            "type": "debugpy",
            "request": "launch",
            "module": "suwalski_investing_server",
            "cwd": "${workspaceFolder}/suwalski_investing_server",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true
        },
        {
            "name": "Run server (auto-reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "suwalski_investing_server.app:app",
                "--reload",
                "--port",
                "6100"
            ],
            "cwd": "${workspaceFolder}/suwalski_investing_server",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true
        },
        {
            "name": "rdcf: NVDA example",
            "type": "debugpy",
            "request": "launch",
            "module": "suwalski_investing_cli",
            "args": [
                "--ticker",
                "NVDA",
                "--optimized-margin",
                "35%",
                "--growth",
                "1-3:55%",
                "--discount",
                "10%",
                "--terminal",
                "3%"
            ],
            "cwd": "${workspaceFolder}/suwalski_investing_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "rdcf: ask for arguments",
            "type": "debugpy",
            "request": "launch",
            "module": "suwalski_investing_cli",
            "args": [
                "--ticker",
                "${input:ticker}",
                "--optimized-margin",
                "${input:optimizedMargin}",
                "--growth",
                "${input:growth}",
                "--discount",
                "${input:discount}",
                "--terminal",
                "${input:terminal}"
            ],
            "cwd": "${workspaceFolder}/suwalski_investing_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "pytest: all projects",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "suwalski_investing_library",
                "suwalski_investing_server",
                "suwalski_investing_cli",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false
        },
        {
            "name": "web (vite dev)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/suwalski_investing_web",
            "command": "pnpm dev"
        }
    ],
    "inputs": [
        {
            "id": "ticker",
            "type": "promptString",
            "description": "Ticker symbol",
            "default": "NVDA"
        },
        {
            "id": "optimizedMargin",
            "type": "promptString",
            "description": "Optimized FCF margin the business settles at",
            "default": "35%"
        },
        {
            "id": "growth",
            "type": "promptString",
            "description": "Known growth, YEARS:RATE (the rest is solved)",
            "default": "1-3:55%"
        },
        {
            "id": "discount",
            "type": "promptString",
            "description": "Discount rate \u2014 the annual return you demand",
            "default": "10%"
        },
        {
            "id": "terminal",
            "type": "promptString",
            "description": "Terminal growth after the projection",
            "default": "3%"
        }
    ]
}
